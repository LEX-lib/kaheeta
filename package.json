    "@tiptap/extension-bullet-list": "^3.27.1",
    "@tiptap/extension-document": "^3.27.1",
    "@tiptap/extension-hard-break": "^3.27.1",
    "@tiptap/extension-heading": "^3.27.1",
    "@tiptap/extension-history": "^3.27.1",
    "@tiptap/extension-italic": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-list-item": "^3.27.1",
    "@tiptap/extension-ordered-list": "^3.27.1",
    "@tiptap/extension-paragraph": "^3.27.1",
    "@tiptap/extension-text": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/vue-3": "^3.27.1",
    "@vueuse/core": "^14.3.0",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.21",
    "iconify-icon": "^3.0.2",
    "jsbarcode": "^3.12.3",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^3.0.4",
    "pocketbase": "^0.27.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "qrcode.vue": "^3.9.1",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.32",
    "vue-pdf-embed": "^2.1.4",
    "vue-router": "^5.0.4",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
